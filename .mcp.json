{
  "mcpServers": {
    "framecraft": {
      "command": "uv",
      "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "framecraft.py", "serve"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "ffmpeg": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "--from", "ffmpeg-mcp-lite", "ffmpeg-mcp-lite"]
    },
    "edge-tts": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "--from", "edge-tts-mcp", "edge_tts_mcp"]
    }
  }
}
